        "command": ["claude", "-p", "{prompt}", "--output-format", "json", "--model", "haiku", "--allowedTools", "Read", "WebSearch", "WebFetch"],
        "resultMode": "claude-json",
        "timeoutMs": 300000
      }
    }
  ]
